{
  // Principal informations
  "name": "worker_name",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],

  // Secret text bindings — configurés dans Cloudflare Dashboard
  // Workers & Pages > login-client-worker > Settings > Secrets.
  // Le format secret_text est requis par l'API REST Cloudflare Workers.
  "secret_texts": [
    {
      "name": "MAIN_USERNAME",
      "text": ""
    },
    {
      "name": "MAIN_PASSWORD",
      "text": ""
    }
  ],

  // Static site
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS"
  },

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}