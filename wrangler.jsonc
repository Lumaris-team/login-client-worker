{
  // Principal informations
  "name": "worker_name",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],

  // Secret Store bindings — injectés automatiquement par update-client-account
  // via wrangler deploy qui gère nativement le type secret_store_secret.
  // Remplacer "__SECRET_STORE_ID__" par l'ID du Secret Store du compte cible.
  "secrets_store_secrets": [
    {
      "binding": "MAIN_USERNAME",
      "store_id": "__SECRET_STORE_ID__",
      "secret_name": "MAIN_USERNAME"
    },
    {
      "binding": "MAIN_PASSWORD",
      "store_id": "__SECRET_STORE_ID__",
      "secret_name": "MAIN_PASSWORD"
    }
  ],

  // Static site
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS"
  },

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}