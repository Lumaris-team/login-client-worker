{
  // Principal informations
  "name": "worker_name",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],

  // Static site
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS"
  },

  // Secret text bindings (déployés via update-client-account)
  // L'API Cloudflare Workers ne supporte PAS le type secret_store_secret
  // dans le metadata de déploiement (erreur 10021). On utilise donc secret_text.
  // Les vraies valeurs doivent être configurées ensuite dans :
  // Cloudflare Dashboard > Workers & Pages > login-client-worker > Settings > Secrets
  "secret_texts": [
    {
      "name": "MAIN_USERNAME",
      "text": ""
    },
    {
      "name": "MAIN_PASSWORD",
      "text": ""
    }
  ],

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}