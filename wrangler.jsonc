{
  // Principal informations
  "name": "worker_name",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],

  // Secrets Store bindings
  // Le store_id est résolu automatiquement lors du déploiement par l'updater.
  "secrets_store_secrets": [
    {
      "binding": "MAIN_USERNAME",
      "store_id": "__SECRET_STORE_ID__",
      "secret_name": "MAIN_USERNAME"
    },
    {
      "binding": "MAIN_PASSWORD",
      "store_id": "__SECRET_STORE_ID__",
      "secret_name": "MAIN_PASSWORD"
    }
  ],

  // Static site
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS"
  },

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}